# Environment configuration template for osmFront
# Copy this file to .env (development) or .env.production (production) and replace the placeholders.

# Frontend config
NEXT_PUBLIC_BASE_DOMAIN=localhost
NEXT_PUBLIC_BASE_PORT=3000
NEXT_PUBLIC_API_BASE=localhost
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_PROTOCOL=http # Use https in production
NEXT_PUBLIC_LOCALES=en,ar
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_TIMEZONE=Asia/Riyadh

# Security
# IMPORTANT: This must match the JWT_SECRET configured in the backend
JWT_SECRET=your_jwt_secret_key_here

# Cookies
TENANT_COOKIE_NAME=tenant
COUNTRY_COOKIE_NAME=country
CURRENCY_COOKIE_NAME=currency
CSRF_COOKIE_NAME=optics_tenant_csrftoken
CSRF_HEADER_NAME=X-OPTICS-TENANT-CSRFToken
LANGUAGE_COOKIE_NAME=django_language

# Defaults
DEFAULT_CURRENCY=sar
DEFAULT_LANGUAGE=en
DEFAULT_COUNTRY=sa

# Environment Mode
NODE_ENV=development # Set to production in production env
NEXT_PUBLIC_DEBUG=true # Set to false in production env
