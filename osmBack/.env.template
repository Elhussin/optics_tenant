# Environment configuration template for osmBack
# Copy this file to .env (development) or .env.production (production) and replace the placeholders.

# Environment
DEBUG=True # Set to False in production
SECRET_KEY='django-insecure-dummy-key-replace-me-in-production' # Generate a strong secret key for production

# Host
ALLOWED_HOSTS=*
TENANT_BASE_DOMAIN=localhost
PORT=8000
FRONTEND_DOMAIN=localhost
FRONTEND_PORT=3000
PROTOCOL=http # Use https in production

# Database
DB_NAME=optics_tenant
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost # e.g., optics_db in docker-compose
DB_PORT=5432
LOCALE=en

# CORS
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with,x-optics-tenant-csrftoken,x-tenant,accept-language,accept-country,accept-currency
CORS_ALLOW_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:3000$,^http://.+\.localhost:3000$
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
AUTH_COOKIE_SECURE=False # Set to True in production
JWT_SECRET=your_jwt_secret_key_here # Replace with strong secret in production

# Wagtail CMS
WAGTAILADMIN_BASE_URL=http://localhost:8000

# PayPal
PAYPAL_MODE=sandbox # Set to live in production
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Email (Zoho SMTP or similar)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_password_here
