# run in luinx
# ENV_FILE=.env.development python manage.py runserver 0.0.0.0:8001
# run in wind
# $env:ENV_FILE = ".env.development" 
# python manage.py runserver 0.0.0.0:8001


# Environment
DEBUG=True
# create secret key
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEV_SECRET_KEY='django-insecure-dummy-key-replace-me-in-production'
SECRET_KEY=${DEV_SECRET_KEY}

# Host
ALLOWED_HOSTS=*
TENANT_BASE_DOMAIN=localhost
PORT=8000
FRONTEND_DOMAIN=localhost
FRONTEND_PORT=3000
PROTOCOL=http
# Database
DB_NAME=optics_tenant
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
# DB_HOST=optics_db
DB_PORT=5432
LOCALE=en
# CORS
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_ALL_ORIGINS=False

CORS_ALLOW_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with,x-optics-tenant-csrftoken,x-tenant,accept-language,accept-country,accept-currency
CORS_ALLOW_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:3000$,^http://.+\.localhost:3000$
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
AUTH_COOKIE_SECURE=False
JWT_SECRET=your_jwt_secret_key_here


WAGTAILADMIN_BASE_URL=http://localhost:8000

PAYPAL_MODE="sandbox" 
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"


EMAIL_HOST='smtp.zoho.com'
EMAIL_PORT=465
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_USE_SSL=True
EMAIL_HOST_USER='info@solovizion.com'
EMAIL_HOST_PASSWORD='your_email_password_here'
